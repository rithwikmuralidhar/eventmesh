# EventMesh configuration. Copy to .env (scripts\setup.ps1 does this); never commit .env.
# Every variable has the EM_ prefix. Defaults point at 127.0.0.1 to avoid IPv6 surprises on Windows.

# development | production | test. Production refuses development defaults and sets Secure cookies.
EM_ENV=development

# Listen addresses. Metrics listeners are bound to 127.0.0.1.
# The spec default is 8080, but that port is often taken by another local web server, so 8090 is used.
EM_HTTP_ADDR=127.0.0.1:8090
EM_METRICS_PORT=9090
EM_WORKER_METRICS_PORT=9091
EM_RECEIVER_ADDR=127.0.0.1:9000

# PostgreSQL (source of truth). Create the database and role first; see docs/windows-setup.md.
EM_DATABASE_URL=postgres://eventmesh:eventmesh@127.0.0.1:5432/eventmesh?sslmode=disable
# Redis-compatible server (Memurai on Windows).
EM_REDIS_URL=redis://127.0.0.1:6379/0
# Prefix for every Redis key. Integration tests set a unique value per run.
EM_REDIS_KEY_PREFIX=em

# Integration tests. Each run creates its own eventmesh_test_<random> database (needs CREATEDB) and
# drops it afterwards, so this URL only needs access to the maintenance database.
EM_TEST_DATABASE_URL=postgres://eventmesh:eventmesh@127.0.0.1:5432/postgres?sslmode=disable
EM_TEST_REDIS_URL=redis://127.0.0.1:6379/1

# 32 random bytes, base64. Encrypts endpoint secrets at rest. The built-in dev key is public.
# Generate one: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
EM_SECRET_ENCRYPTION_KEY=ZXZlbnRtZXNoLWRldi1vbmx5LWtleS0zMi1ieXRlcyE=

# Browser origins allowed to call the API with cookies (comma separated).
EM_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
EM_SESSION_TTL=168h

# false refuses new accounts (POST /auth/register answers 403); existing accounts still sign in.
EM_ALLOW_REGISTRATION=true
# Proxies/tunnels (IPs or CIDRs) whose X-Forwarded-For is trusted for the client IP used in rate limiting.
# Empty: the TCP peer address is the client. Only list a proxy that overwrites the header.
EM_TRUSTED_PROXIES=

# Serve frontend/dist from the API (one origin, no nginx).
EM_SERVE_FRONTEND=false
EM_FRONTEND_DIR=../frontend/dist

# Worker pool and delivery policy. EM_MAX_RETRIES=5 means 1 attempt + up to 5 retries = 6 attempts.
EM_WORKER_COUNT=10
EM_SHUTDOWN_TIMEOUT=20s
EM_MAX_RETRIES=5
EM_INITIAL_RETRY_DELAY=2s
EM_MAX_RETRY_DELAY=5m
EM_DELIVERY_TIMEOUT=15s
EM_LEASE_DURATION=60s
EM_SCHEDULER_INTERVAL=500ms
EM_REAPER_INTERVAL=10s
EM_RECONCILER_INTERVAL=30s
EM_RECONCILER_GRACE=30s

# Rate limits (requests per second, burst). Auth limit is attempts per minute per IP and per email.
EM_API_RATE_LIMIT=100
EM_API_RATE_BURST=200
EM_INGEST_RATE_LIMIT=50
EM_INGEST_RATE_BURST=100
EM_AUTH_RATE_LIMIT_PER_MINUTE=10

# DEVELOPMENT ONLY: hosts exempt from the SSRF IP checks so demo deliveries can reach the local receiver.
# Must be empty in production.
EM_SSRF_ALLOWED_HOSTS=127.0.0.1,localhost

# Local receiver: the default secret it verifies signatures with (the seed gives demo endpoints the same value).
EM_RECEIVER_SECRET=whsec_local_receiver_dev_secret
EM_API_BASE_URL=http://127.0.0.1:8090
EM_DEMO_EVENT_COUNT=40

# ---- Milestone 11: optional AI features (all off by default) ----
# The core system runs with all of this unset. A feature runs only when its flag is true,
# the provider is set AND the key is present. Never commit a key; .env is git-ignored.
EM_AI_PROVIDER=
EM_AI_API_KEY=
EM_AI_CHAT_MODEL=gemini-3.6-flash
EM_AI_EMBED_MODEL=gemini-embedding-001
EM_AI_EMBED_DIMENSIONS=768
EM_AI_MAX_OUTPUT_TOKENS=512
EM_AI_MAX_INPUT_CHARS=8000
EM_AI_REQUESTS_PER_MINUTE=10
EM_AI_DOCS_INDEX_ON_START=false
# Repository root holding README.md and docs/ (relative to the backend folder).
EM_AI_DOCS_ROOT=..
EM_FEATURE_AI_DOCS=false
EM_FEATURE_AI_EXPLAIN=false
EM_FEATURE_AI_SEARCH=false

# Minimum cosine similarity for "found in the docs". Empty/0 = built-in default 0.68, chosen from docs/ai-evaluation.md.
# Choose it from the score ranges printed by scriptsval-docs.ps1.
EM_AI_MIN_SIMILARITY=

# ---- Caching, tracing, dispatch (all optional) ----
# Dashboard statistics are served from Redis for this long (X-Cache: HIT/MISS). 0 turns the cache off.
EM_STATS_CACHE_TTL=5s
# OpenTelemetry traces: none | stdout (JSON spans on stderr) | otlp (HTTP, to a collector such as Jaeger).
EM_TRACE_EXPORTER=none
EM_TRACE_OTLP_ENDPOINT=127.0.0.1:4318
# Share of new traces recorded (0..1). A request that arrives already sampled stays sampled.
EM_TRACE_SAMPLE_RATIO=1
# Goroutines claiming jobs from Redis for the worker pool. See docs/performance.md before raising it.
EM_DISPATCHER_COUNT=1
